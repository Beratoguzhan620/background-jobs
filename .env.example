# Copy to .env to override the local defaults used by docker compose.
POSTGRES_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
# At least 12 characters. Used only to create the first admin when the database has no users.
ADMIN_PASSWORD=change-me-please
# At least 32 characters. Leave empty to get a throwaway key per container start (local use only).
JWT_SIGNING_KEY=
